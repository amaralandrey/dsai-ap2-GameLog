# FONTES_TIMEOUT=15
# RAWG_API_KEY=   # chave gratuita em https://rawg.io/apidocs; sem ela a fonte rawg fica desligada
# STEAM_API_KEY=   # chave da Web API em https://steamcommunity.com/dev/apikey; sem ela não há importação de horas
# VERIFICACAO_PROVEDOR=simulado   # só em teste: liga o provedor de idade simulado em /conta/idade (IDA-07)
# JOBS_TOKEN=um-segredo-longo   # liga POST /jobs/ciclo para o cron HTTP externo (JOB-11)
# E-mail (EML-03): sem SMTP_HOST, o e-mail vai para o log (backend de console)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587   # 465 usa SSL; as outras, STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_REMETENTE=GameLog <nao-responda@exemplo.com>
# URL_PUBLICA=http://127.0.0.1:5000   # base dos links nos e-mails enviados pelos jobs
BACKUP_KEY=
BACKUP_RESTAURAR_DE=
